cmake_minimum_required(VERSION 3.22)

# Run only after every reference process in RUN_DIR completed successfully.
foreach(required RUN_DIR PROFILE_DIR OUTPUT_DIR)
	if(NOT DEFINED ${required})
		message(FATAL_ERROR "capture.cmake requires ${required}")
	endif()
endforeach()
file(READ "${PROFILE_DIR}/reference.json" reference)
string(JSON manifest SET "${reference}" fixtures "{}")
file(GLOB_RECURSE captures LIST_DIRECTORIES false "${RUN_DIR}/*.jsonl")
list(SORT captures)
list(LENGTH captures capture_count)
if(capture_count EQUAL 0)
	message(FATAL_ERROR "Reference run emitted no captures")
endif()
set(names "")
foreach(capture IN LISTS captures)
	file(RELATIVE_PATH relative "${RUN_DIR}" "${capture}")
	string(REGEX MATCH "^([^/]+)/(.+)\\.jsonl$" matched "${relative}")
	if(NOT matched)
		message(FATAL_ERROR "Capture has no producer directory: ${relative}")
	endif()
	set(producer "${CMAKE_MATCH_1}")
	set(name "${CMAKE_MATCH_2}")
	if(name IN_LIST names)
		message(FATAL_ERROR "Duplicate reference fixture: ${name}")
	endif()
	list(APPEND names "${name}")
	file(STRINGS "${capture}" records ENCODING UTF-8)
	list(LENGTH records record_count)
	if(record_count EQUAL 0)
		message(FATAL_ERROR "Reference fixture has zero observations: ${name}")
	endif()
	file(SHA256 "${capture}" digest)
	file(SHA256 "${OUTPUT_DIR}/${name}.jsonl" copied_digest)
	if(NOT digest STREQUAL copied_digest)
		message(FATAL_ERROR "Merged capture differs from producer output: ${name}")
	endif()
	set(entry "{}")
	string(JSON entry SET "${entry}" producer "\"${producer}\"")
	string(JSON entry SET "${entry}" records "${record_count}")
	string(JSON entry SET "${entry}" sha256 "\"${digest}\"")
	string(JSON entry SET "${entry}" completed true)
	string(JSON manifest SET "${manifest}" fixtures "${name}" "${entry}")
endforeach()
if(DEFINED DEBUG_MANIFEST)
	file(READ "${DEBUG_MANIFEST}" debug_reference)
	string(JSON manifest SET "${manifest}" debug "${debug_reference}")
	string(JSON debug_count LENGTH "${debug_reference}" fixtures)
	if(debug_count EQUAL 0)
		message(FATAL_ERROR "Debug reference has no captures")
	endif()
	math(EXPR debug_last "${debug_count} - 1")
	foreach(index RANGE 0 ${debug_last})
		string(JSON name MEMBER "${debug_reference}" fixtures ${index})
		if(name IN_LIST names)
			message(FATAL_ERROR "Debug capture collides with release capture: ${name}")
		endif()
		string(JSON entry GET "${debug_reference}" fixtures "${name}")
		file(SHA256 "${OUTPUT_DIR}/${name}.jsonl" digest)
		string(JSON expected GET "${entry}" sha256)
		if(NOT digest STREQUAL expected)
			message(FATAL_ERROR "Merged Debug capture changed: ${name}")
		endif()
		string(JSON entry SET "${entry}" profile "\"debug\"")
		string(JSON manifest SET "${manifest}" fixtures "${name}" "${entry}")
	endforeach()
endif()
if(DEFINED NATIVE_RESULTS)
	file(READ "${NATIVE_RESULTS}" native_results)
	string(JSON manifest SET "${manifest}" native "${native_results}")
endif()
file(WRITE "${OUTPUT_DIR}/manifest.json" "${manifest}\n")
message(STATUS "Recorded ${capture_count} completed C captures")
