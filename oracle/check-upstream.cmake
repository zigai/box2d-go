cmake_minimum_required(VERSION 3.22)
foreach(required LOG INVENTORY OUTPUT)
	if(NOT DEFINED ${required})
		message(FATAL_ERROR "check-upstream.cmake requires ${required}")
	endif()
endforeach()
file(READ "${INVENTORY}" inventory)
string(JSON expected_suites LENGTH "${inventory}" suites)
file(STRINGS "${LOG}" lines)
set(pending "")
set(completed "")
set(ledger "{\"suites\":{}}")
string(JSON pin GET "${inventory}" upstream)
string(JSON ledger SET "${ledger}" upstream "\"${pin}\"")
set(case_count 0)
foreach(line IN LISTS lines)
	if(line MATCHES "^  subtest passed: ([A-Za-z0-9_]+)$")
		list(APPEND pending "${CMAKE_MATCH_1}")
	elseif(line MATCHES "^test passed: ([A-Za-z0-9_]+) after ")
		set(suite "${CMAKE_MATCH_1}")
		if(suite IN_LIST completed)
			message(FATAL_ERROR "Native runner repeated suite ${suite}")
		endif()
		string(JSON expected_count ERROR_VARIABLE error LENGTH "${inventory}" suites "${suite}" cases)
		if(error)
			message(FATAL_ERROR "Native runner emitted undeclared suite ${suite}")
		endif()
		set(expected "")
		set(cases "{}")
		if(expected_count GREATER 0)
			math(EXPR last "${expected_count} - 1")
			foreach(index RANGE 0 ${last})
				string(JSON name MEMBER "${inventory}" suites "${suite}" cases ${index})
				list(APPEND expected "${name}")
			endforeach()
		endif()
		list(SORT pending)
		list(SORT expected)
		if(NOT "${pending}" STREQUAL "${expected}")
			message(FATAL_ERROR "Native ${suite} collection mismatch: expected [${expected}], passed [${pending}]")
		endif()
		foreach(name IN LISTS pending)
			string(JSON cases SET "${cases}" "${name}" "\"passed\"")
		endforeach()
		if(expected_count EQUAL 0)
			math(EXPR case_count "${case_count} + 1")
		else()
			math(EXPR case_count "${case_count} + ${expected_count}")
		endif()
		string(JSON entry SET "{}" cases "${cases}")
		string(JSON entry SET "${entry}" status "\"passed\"")
		string(JSON ledger SET "${ledger}" suites "${suite}" "${entry}")
		list(APPEND completed "${suite}")
		set(pending "")
	elseif(line MATCHES "(subtest failed:|test failed:|test skipped:|condition false:)")
		message(FATAL_ERROR "Native runner did not complete all active cases: ${line}")
	endif()
endforeach()
list(LENGTH completed completed_count)
if(NOT completed_count EQUAL expected_suites OR NOT "${pending}" STREQUAL "")
	message(FATAL_ERROR "Native suite collection incomplete: ${completed_count}/${expected_suites}")
endif()
string(JSON ledger SET "${ledger}" active_cases "${case_count}")
file(WRITE "${OUTPUT}" "${ledger}\n")
message(STATUS "Unchanged upstream runner passed ${completed_count} suites / ${case_count} active cases")
